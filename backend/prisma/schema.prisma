generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique
  password  String?
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  senders   Sender[]
}

model Sender {
  id           String          @id @default(cuid())
  senderName   String
  senderEmail  String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  hourlyLimit  Int
  dailyLimit   Int?
  isActive     Boolean         @default(true)
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  emails       EmailSchedule[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model EmailSchedule {
  id                 String       @id @default(cuid())
  senderId           String
  sender             Sender       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipientEmail     String
  subject            String
  body               String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus
  bullJobId          String?      @unique
  retryCount         Int          @default(0)
  failureReason      String?
  providerMessageId  String?
  delayBetweenEmails Int
  hourlyLimit        Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  retries            EmailRetry[]
  outbox             EmailOutbox?

  @@index([senderId, status, scheduledAt])
}

model EmailRetry {
  id            String        @id @default(cuid())
  emailId       String
  email         EmailSchedule @relation(fields: [emailId], references: [id], onDelete: Cascade)
  attemptNumber Int
  error         String
  retryTime     DateTime
  createdAt     DateTime      @default(now())
}

model EmailOutbox {
  id          String       @id @default(cuid())
  emailId     String       @unique
  email       EmailSchedule @relation(fields: [emailId], references: [id], onDelete: Cascade)
  status      OutboxStatus @default(PENDING)
  claimedAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, claimedAt])
}

enum EmailStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
  RETRYING
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}
